# System Factory configuration (copy to .env or set in your shell; .env is git-ignored).
# Runtime: "simulated" (deterministic, default, no LLM) or "ollama" (real local inference).
SF_RUNTIME=simulated
# Where runtime state lives (SQLite DB, generated demo repo, worktrees, evidence). Default: ./data
# SF_DATA_DIR=./data

# --- Ollama (local LLM runtime) ---
SF_OLLAMA_URL=http://127.0.0.1:11434
SF_CODER_MODEL=qwen2.5-coder:14b
SF_REVIEWER_A_MODEL=phi4:14b
SF_REVIEWER_B_MODEL=gemma3:12b
SF_OLLAMA_TIMEOUT=300
SF_OLLAMA_NUM_CTX=12288
SF_OLLAMA_KEEP_ALIVE=10m
SF_CODER_MAX_TURNS=6

# --- Reviewers used in simulated runtime (comma-separated adapters) ---
SF_REVIEWERS=simulated-spec,simulated-diff

# --- Paid/cloud providers: inactive unless explicitly approved ---
# ANTHROPIC_API_KEY=            # never commit a real key
# SF_ALLOW_PAID_INFERENCE=1
